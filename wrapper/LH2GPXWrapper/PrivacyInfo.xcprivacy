<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
	  NSPrivacyCollectedDataTypes: precise location

	  The app optionally sends live GPS track points (latitude, longitude, timestamp,
	  horizontal accuracy) to a user-configured HTTPS server. This feature is:
	    - disabled by default (sendsLiveLocationToServer = false)
	    - user-initiated: requires explicit activation in Options + manual URL entry
	    - sent only to a server the user owns / explicitly configures
	    - not linked to any identity, not used for advertising or analytics

	  Apple's Privacy Manifest guidance requires declaring data types that MAY be
	  collected, even when optional. The upload is user-controlled App Functionality.

	  NSPrivacyCollectedDataTypeLinked = false  (no identity linkage in the app)
	  NSPrivacyCollectedDataTypeTracking = false (not for ad/analytics tracking)
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<!-- App Functionality: user explicitly sends their own live track to their own server -->
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!--
		  NSPrivacyAccessedAPICategoryFileTimestamp

		  The app calls `FileManager.attributesOfItem(atPath:)` against
		  files the user has explicitly granted access to via the system
		  document picker (LH2GPX `app_export.json/.zip`, Google Timeline
		  `location-history.json/.zip`, GPX, TCX). The call is used to
		  read `.size` (`FileAttributeKey.size`) for input-gating:
		    - `AppContentLoader.swift` (3 sites): autoRestore size cap,
		      max-supported-file-size guard, in-memory-import cap
		      (64 MiB).
		    - `GoogleTimelineStoreImporter.swift` (1 site): total-byte
		      hint for the streaming progress emitter.

		  We do not read `.modificationDate` / `.creationDate` and never
		  surface file timestamps to the user. The API category is still
		  declared because `attributesOfItem` itself is on Apple's list
		  of timestamp-accessing APIs. Reason `0A2A.1` covers files the
		  user has specifically granted the app access to.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>0A2A.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
