<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.de.roeber.LH2GPXWrapper</string>
	</array>
	<!--
	  iCloud capability for the LH2GPX-Wrapper iOS app.

	  Container `iCloud.de.roeber.LH2GPXWrapper` must additionally be
	  registered in the Apple Developer Portal (App-ID "de.roeber.LH2GPXWrapper"
	  → iCloud service → container "iCloud.de.roeber.LH2GPXWrapper"). The
	  entitlement file declares the container the app uses; the Portal
	  declares the container exists. Without the Portal step, signing on a
	  development team will fail. See docs/ICLOUD_SYNC_ARCHITECTURE.md §5
	  (Train F.1) for the Apple-host workflow.

	  Current CloudKit usage (Phase D + D.1 + D.2, 2026-05-25):
	  - `CloudKitICloudHealthCheckService` writes/reads/deletes a
	    non-sensitive `LH2GPXCloudHealthProbe` record in
	    `privateCloudDatabase` (stage-granular health probe).
	  - `LiveTrackCloudBackupService` opt-in only: stores
	    `LH2GPXLiveTrackSummary` and (when the user enables it)
	    `LH2GPXLiveTrackPointBatch` in `privateCloudDatabase` for newly
	    completed LiveTracks. Imported Google-history is never auto-synced.
	  - No public/shared CloudKit database, no CKAsset, no CKSubscription.
	-->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.de.roeber.LH2GPXWrapper</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!--
	  WeatherKit-Entitlement (PR #44 UI-Integration; Apple-Portal-Side
	  von 2026-05-27). Ohne diesen Key liefert `WeatherService.shared`
	  einen Auth-Error, der vom `AppWeatherCacheManager` als
	  `weatherLayerError` propagiert und den Settings-Toggle auto-deaktiviert.
	-->
	<key>com.apple.developer.weatherkit</key>
	<true/>
</dict>
</plist>
