            "value" : "Diese App hat derzeit keine Cloud-Synchronisierung und keinen Servertransfer. Hintergrundaufzeichnung bleibt lokal auf diesem Gerät und hängt weiterhin von Apples Standortfreigabe ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
